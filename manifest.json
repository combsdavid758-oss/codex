{
  "manifest_version": 3,
  "name": "Instant Form Deeplink Editor",
  "version": "1.3.0",
  "description": "Preview and apply a final CTA deeplink to one manually saved duplicate TikTok form.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "editor.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ads.tiktok.com/*"
      ],
      "js": [
        "core.js",
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://ads.tiktok.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}